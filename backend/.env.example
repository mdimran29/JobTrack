DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public"
# At least 32 characters in production. Generate one with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_ORIGIN="http://localhost:5173"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite"
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_APP_KEY="your-adzuna-app-key"
RAPIDAPI_KEY="optional-rapidapi-key"
