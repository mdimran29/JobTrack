{
  "info": {
    "name": "JobTrack API",
    "description": "JobTrack backend API. Auth uses an httpOnly JWT cookie set by /auth/login or /auth/register — Postman stores and resends it automatically, no manual token handling needed. Run requests top-to-bottom within a folder; Create requests auto-save their id into collection variables for the requests below them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "applicationId", "value": "" },
    { "key": "interviewId", "value": "" },
    { "key": "noteId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo2@jobtrack.dev\",\n  \"password\": \"password123\",\n  \"name\": \"Demo Two\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (seeded demo user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@jobtrack.dev\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications?page=1&limit=20&sortBy=appliedDate&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "INTERVIEW", "disabled": true },
                { "key": "search", "value": "google", "disabled": true },
                { "key": "sortBy", "value": "appliedDate" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('applicationId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Corp\",\n  \"position\": \"Senior Engineer\",\n  \"status\": \"APPLIED\",\n  \"appliedDate\": \"2026-08-01\",\n  \"location\": \"Remote\",\n  \"source\": \"LinkedIn\",\n  \"jobUrl\": \"https://acme.example.com/careers/123\",\n  \"followUpDate\": \"2026-08-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] }
          }
        },
        {
          "name": "Get By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SCREENING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Follow Ups",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "follow-ups"]
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Interviews",
      "item": [
        {
          "name": "Create (nested under application)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('interviewId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PHONE_SCREEN\",\n  \"scheduledAt\": \"2026-08-15T15:00:00Z\",\n  \"interviewerName\": \"Jane Doe\",\n  \"mode\": \"remote\",\n  \"durationMinutes\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/interviews",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "interviews"]
            }
          }
        },
        {
          "name": "List (nested under application)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/interviews",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "interviews"]
            }
          }
        },
        {
          "name": "Update (standalone)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"PASSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/interviews/{{interviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["interviews", "{{interviewId}}"]
            }
          }
        },
        {
          "name": "Delete (standalone)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/interviews/{{interviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["interviews", "{{interviewId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create (nested under application)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('noteId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great culture fit, follow up next week.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "notes"]
            }
          }
        },
        {
          "name": "List (nested under application)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "notes"]
            }
          }
        },
        {
          "name": "Update (standalone)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated note content.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["notes", "{{noteId}}"]
            }
          }
        },
        {
          "name": "Delete (standalone)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["notes", "{{noteId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["dashboard", "stats"] }
          }
        }
      ]
    }
  ]
}
